# Strapi (members area sign-in). Server-side only; no NEXT_PUBLIC_ prefix.
# Example: http://localhost:1337  or  https://cms.example.com
STRAPI_URL=https://unputrefiable-lucille-expansional.ngrok-free.dev #http://127.0.0.1:1337

# Optional. Where the browser goes after logout (and after 401 session invalidation). Default: /login
# NEXT_PUBLIC_AUTH_LOGOUT_REDIRECT=/login

# PostHog (client). Required in deployed envs if analytics should load — see .comms/ENVIRONMENT-AND-CONFIG-REFERENCE.md
NEXT_PUBLIC_POSTHOG_KEY=phc_DHu2srwW6irGnPFpUR6UYSCKnRSBJ2CRKdXsg7z6I55
# Explicit opt-in for client analytics (consent + key also required). Ingest is proxied via /ingest in next.config.ts.
NEXT_PUBLIC_FEATURE_ANALYTICS=false

# Sentry: source map upload during `next build` (CI secret; never commit)
# SENTRY_AUTH_TOKEN=

# Set automatically in many CI systems; affects Sentry plugin verbosity during build
CI=false

